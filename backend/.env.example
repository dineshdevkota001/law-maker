# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/law_maker

# Gemini generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Gemini embeddings (separate key + model name)
GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Upload and retrieval behavior
MAX_UPLOAD_MB=25
DEFAULT_SUBJECT=general
DEFAULT_TOP_K=6

# Source file storage
PDF_STORAGE_DIR=data/uploads
SOURCE_URL_TTL_SECONDS=900
