# Database
# Local Postgres:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/law_maker
#
# Render is IPv4-only. Use the Supabase Session pooler (port 5432), not db.*.supabase.co.
# Dashboard: Project Settings → Database → Connect → Session pooler
# Username is postgres.<project-ref>, host is *.pooler.supabase.com
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Gemini generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Gemini embeddings (separate key + model name)
GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Upload and retrieval behavior
MAX_UPLOAD_MB=25
DEFAULT_SUBJECT=general
DEFAULT_TOP_K=6

# Supabase Storage (PDF uploads). HTTPS API is IPv4; no pooler needed.
# Use the project URL + service role / secret key (server-side only).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_BUCKET=documents

# Local fallback only when Supabase is unset (not used on Render)
PDF_STORAGE_DIR=data/uploads
SOURCE_URL_TTL_SECONDS=900
